---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  jsonLd?: object[];
}
const { path = Astro.url.pathname, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- preloaded so the font swap doesn't shift layout (fallback serifs on Linux/Android are much wider) -->
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <Seo {...seo} path={path} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip ui" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="col" style="padding-block:1.5rem 3rem;flex:1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
