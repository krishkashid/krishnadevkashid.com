{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes serve@14.2.4 dist -l 4321",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/about",
        "http://localhost:4321/essays"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
